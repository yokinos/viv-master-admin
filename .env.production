# 打包路径
VITE_BASE_URL = /
# 生产不走 Vite 代理：由网关/反代按 /{服务短名}/api 路由到各服务
VITE_IS_REQUEST_PROXY = false

# 同源部署：留空即使用当前域名（/apex/api/... 由反代转到网关）
VITE_API_URL =

# 客户端对外标识，对应 AtClientApp.AppKey
VITE_VIV_APP_KEY = viv-rootadmin-app

# EmUserType：Master=0 / OrgUser=1 / CompanyUser=2 / TenantUser=3
VITE_VIV_USER_TYPE = 0
